config rust-dns 'config'
	option enabled '0'
	option configfile '/var/etc/rust-dns/config.json'
	option listen_address '0.0.0.0'
	option listen_port '5335'
	option log_level 'error'
	option log_file '/var/log/rust-dns.log'
	option log_size '1'
	option log_backups '2'
	option redirect '0'
	option local_dns_redirect '0'
	option cache '1'
	option cache_size '8000'
	option lazy_cache_ttl '86400'
	option dump_interval '3600'
	option prefetch '0'
	option prefetch_before_expire '10'
	option prefetch_min_hits '3'
	option prefetch_scan_interval '5'
	option concurrent '2'
	option idle_timeout '30'
	option enable_pipeline '1'
	option insecure_skip_verify '0'
	option bootstrap_dns '119.29.29.29'
	list remote_dns 'tls://8.8.8.8'
	list local_dns '119.29.29.29'
	list stream_media_dns 'tls://8.8.8.8'
	option minimal_ttl '0'
	option maximum_ttl '0'
	option prefer_ipv4_cn '0'
	option prefer_ipv4 '0'
	option reject_type65 '0'
	option dns_leak '0'
	option enable_ecs_remote '0'
	option remote_ecs_ip ''
	option adblock '0'
	list ad_source ''
	option cloudflare '0'
	list cloudflare_ip ''
	option listen_port_api '9091'
	option api_listen_address '127.0.0.1'
	option stats_collector '1'
	option stats_capacity '2000'
	option stats_dump_file '0'
	option stats_dump_interval '600'
	option stats_dump_path '/var/rust-dns/stats.dump'
	option stats_history_max '168'
	option stats_top_max '100'
	option stats_logs_max '200'
	option geo_auto_update '0'
	option geo_update_week_time '*'
	option geo_update_day_time '2'
	option geoip_type 'geoip-only-cn-private'
	option github_proxy ''
	list geosite_tags ''
	list geoip_tags ''
