config rust-dns 'config'
	option enabled '1'
	option configfile '/var/etc/rust-dns/config.json'
	option listen_address '::'
	option listen_port '5353'
	option log_level 'info'
	option log_file '/var/log/rust-dns.log'
	option log_size '5'
	option log_backups '4'
	option redirect '1'
	option local_dns_redirect '1'
	option cache '0'
	option cache_size '0'
	option lazy_cache_ttl '60'
	option dump_interval '120'
	option prefetch '1'
	option prefetch_before_expire '30'
	option prefetch_min_hits '5'
	option prefetch_scan_interval '15'
	option concurrent '8'
	option idle_timeout '45'
	option enable_pipeline '0'
	option insecure_skip_verify '1'
	option bootstrap_dns '223.5.5.5'
	list remote_dns 'tls://1.1.1.1'
	list remote_dns 'quic://dns.adguard.com'
	list local_dns '223.5.5.5'
	list local_dns '119.29.29.29'
	list stream_media_dns '8.8.8.8'
	option minimal_ttl '60'
	option maximum_ttl '3600'
	option prefer_ipv4_cn '1'
	option prefer_ipv4 '1'
	option reject_type65 '1'
	option dns_leak '1'
	option enable_ecs_remote '1'
	option remote_ecs_ip '1.2.3.4'
	option adblock '1'
	list ad_source 'https://example.invalid/adlist.txt'
	option cloudflare '1'
	list cloudflare_ip '1.1.1.1'
	list cloudflare_ip '2606:4700::1111'
	option listen_port_api '9191'
	option api_listen_address '::1'
	option stats_collector '0'
	option stats_capacity '50'
	option stats_dump_file '1'
	option stats_dump_interval '5'
	option stats_dump_path '/var/rust-dns/stats.dump'
	option stats_history_max '999'
	option stats_top_max '5000'
	option stats_logs_max '999'
	option geo_auto_update '1'
	option geo_update_week_time '6'
	option geo_update_day_time '23'
	option geoip_type 'geoip-only-cn-private'
	option github_proxy ''
	list geosite_tags 'cn'
	list geoip_tags 'cn'
