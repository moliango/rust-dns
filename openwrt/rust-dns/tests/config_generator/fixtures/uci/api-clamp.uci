config rust-dns 'config'
	option enabled '1'
	option listen_address '0.0.0.0'
	option listen_port '5335'
	option log_level 'warning'
	option log_file '/var/log/rust-dns.log'
	option log_size '2'
	option log_backups '3'
	option cache '1'
	option cache_size '1000'
	option bootstrap_dns '119.29.29.29'
	list remote_dns 'tls://8.8.8.8'
	list local_dns '119.29.29.29'
	list stream_media_dns 'tls://8.8.8.8'
	option listen_port_api '9091'
	option api_listen_address '0.0.0.0'
	option stats_collector '1'
	option stats_capacity '2000'
	option stats_dump_file '0'
	option stats_dump_interval '600'
	option stats_history_max '168'
	option stats_top_max '100'
	option stats_logs_max '200'
