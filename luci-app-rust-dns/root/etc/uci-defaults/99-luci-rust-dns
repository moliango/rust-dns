#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Register the rust-dns init script with ucitrack so that UCI commits trigger
# a service reload. Adapted from luci-app-mosdns (uci-defaults/luci-mosdns),
# Copyright (C) 2023-2026 sbwml <admin@cooluc.com>, GPL-3.0.

[ -f "/etc/config/ucitrack" ] && {
	uci -q batch <<-EOF >/dev/null
		delete ucitrack.@rust-dns[-1]
		add ucitrack rust-dns
		set ucitrack.@rust-dns[-1].init='rust-dns'
		commit ucitrack
	EOF
}

rm -rf /tmp/luci-*
exit 0
