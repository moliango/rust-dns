msgid "Custom Stream Media DNS"
msgstr "自定义流媒体 DNS"

msgid "Streaming media rules use this DNS server."
msgstr "流媒体规则将使用此 DNS 服务器。"

msgid "Streaming Media DNS server"
msgstr "流媒体 DNS 服务器"

msgid "Bootstrap DNS servers"
msgstr "Bootstrap DNS 服务器"

msgid "Bootstrap DNS servers resolve the IP addresses of DoH/DoT upstreams."
msgstr "Bootstrap DNS 用于解析 DoH/DoT 上游的 IP 地址。"

msgid "Configuration Editor"
msgstr "配置编辑器"

msgid "Contents of %s. The file is validated with \"rust-dns check\" before it replaces the current configuration."
msgstr "%s 的内容。保存前会使用 \"rust-dns check\" 校验，校验通过后才会替换当前配置。"

msgid "rust-dns rejected the configuration."
msgstr "rust-dns 拒绝了该配置。"

msgid "Configuration saved, but restarting the service failed: %s"
msgstr "配置已保存，但重启服务失败：%s"

msgid "Configuration validation failed: %s"
msgstr "配置校验失败：%s"

msgid "Concurrent"
msgstr "并发数"

msgid "Number of upstream DNS servers that may be queried at the same time."
msgstr "允许同时查询的上游 DNS 服务器数量。"

msgid "Idle Timeout"
msgstr "空闲超时"

msgid "DoH/TCP/DoT connection multiplexing idle timeout (seconds)."
msgstr "DoH/TCP/DoT 连接复用空闲超时（秒）。"

msgid "TCP/DoT Connection Multiplexing"
msgstr "TCP/DoT 连接复用"

msgid "Enable RFC 7766 query pipelining for TCP/DoT connections."
msgstr "为 TCP/DoT 连接启用 RFC 7766 查询流水线。"

msgid "Disable TLS Certificate Check"
msgstr "禁用 TLS 证书校验"

msgid "Skip TLS certificate validation for upstream servers. Use only when the system time or CA store is broken."
msgstr "跳过上游服务器的 TLS 证书校验。仅在系统时间或 CA 证书存储异常时使用。"

msgid "Enable EDNS Client Subnet"
msgstr "启用 EDNS 客户端子网"

msgid "ECS IP Address"
msgstr "ECS IP 地址"

msgid "IP address used for remote upstream ECS. The /24 subnet is sent to the upstream."
msgstr "用于远程上游 ECS 的 IP 地址，将向上游发送其 /24 子网。"

msgid "Prevent DNS Leaks"
msgstr "防止 DNS 泄漏"

msgid "Force the fallback policy to use the remote DNS upstream."
msgstr "强制 fallback 策略使用远程 DNS 上游。"

msgid "Enable DNS Cache"
msgstr "启用 DNS 缓存"

msgid "DNS Cache Size"
msgstr "DNS 缓存容量"

msgid "Lazy Cache TTL"
msgstr "惰性缓存 TTL"

msgid "How long expired cache entries stay usable (seconds). Set to 0 to disable lazy caching."
msgstr "过期缓存条目可继续使用的时长（秒）。设为 0 可禁用惰性缓存。"

msgid "Cache Prefetching"
msgstr "缓存预取"

msgid "Refresh hot cache entries in the background before they expire."
msgstr "在热点缓存条目过期前后台刷新。"

msgid "Prefetch Before Expire"
msgstr "过期前预取"

msgid "Prefetch when the remaining TTL is below this value (seconds)."
msgstr "剩余 TTL 低于该值时触发预取（秒）。"

msgid "Prefetch Min Hits"
msgstr "预取最小命中数"

msgid "Minimum cache hits since the last refresh before a prefetch is triggered."
msgstr "自上次刷新以来触发预取所需的最小缓存命中次数。"

msgid "Prefetch Scan Interval"
msgstr "预取扫描间隔"

msgid "Interval between background cache scans (seconds)."
msgstr "后台扫描缓存的间隔（秒）。"

msgid "Cache Dump"
msgstr "缓存转储"

msgid "Persist the cache and reload it on the next startup."
msgstr "持久化缓存并在下次启动时重新加载。"

msgid "Auto Save Cache Interval"
msgstr "缓存自动保存间隔"

msgid "Minimum TTL"
msgstr "最小 TTL"

msgid "Clamp the minimum DNS answer TTL (seconds). 0 disables clamping."
msgstr "限制 DNS 应答的最小 TTL（秒）。0 表示不限制。"

msgid "Maximum TTL"
msgstr "最大 TTL"

msgid "Clamp the maximum DNS answer TTL (seconds). 0 disables clamping."
msgstr "限制 DNS 应答的最大 TTL（秒）。0 表示不限制。"

msgid "Disable RR Type 65 (HTTPS/SVCB)"
msgstr "禁用 RR 类型 65（HTTPS/SVCB）"

msgid "Block HTTPS/SVCB records and force A/AAAA answers only."
msgstr "拦截 HTTPS/SVCB 记录，仅返回 A/AAAA 记录。"

msgid "Enable DNS Adblock"
msgstr "启用 DNS 广告过滤"

msgid "Adblock Source"
msgstr "广告过滤规则来源"

msgid "Local files and domain lists are supported, for example file:///var/rust-dns/example.txt."
msgstr "支持本地文件与域名列表，例如 file:///var/rust-dns/example.txt。"

msgid "Rewrite answers that match Cloudflare IP ranges to a custom IP (experimental)."
msgstr "将匹配 Cloudflare IP 段的应答改写为自定义 IP（实验性）。"

msgid "Custom IP"
msgstr "自定义 IP"

msgid "Cloudflare IP Ranges"
msgstr "Cloudflare IP 段"

msgid "The CIDR list is maintained by the rust-dns service package in %s and can be refreshed by the Cloudflare optimizer."
msgstr "CIDR 列表由 rust-dns 服务包维护于 %s，可通过 Cloudflare 优选工具刷新。"

msgid "API Listen Port"
msgstr "API 监听端口"

msgid "Enable Stats Collector"
msgstr "启用统计采集器"

msgid "Ring Buffer Capacity"
msgstr "环形缓冲区容量"

msgid "Query log ring buffer capacity (FIFO overwrite). Larger values use more memory."
msgstr "查询日志环形缓冲区容量（FIFO 覆盖）。容量越大内存占用越高。"

msgid "Stats Dump"
msgstr "统计数据转储"

msgid "Persist query statistics and logs and reload them on the next startup."
msgstr "持久化查询统计与日志，并在下次启动时重新加载。"

msgid "Auto Save Stats Interval"
msgstr "统计数据自动保存间隔"

msgid "Security Notice"
msgstr "安全提示"

msgid "The admin API is bound to 127.0.0.1 by the rust-dns service. Do not expose the API port to untrusted networks."
msgstr "rust-dns 服务将管理 API 绑定在 127.0.0.1。请勿将 API 端口暴露到不可信网络。"

msgid "Flushing the cache removes all cached DNS records."
msgstr "刷新缓存将清除所有已缓存的 DNS 记录。"

msgid "Flush DNS Cache"
msgstr "刷新 DNS 缓存"

msgid "GeoSite Tags"
msgstr "GeoSite 分类"

msgid "GeoSite categories to export. Multiple tags are allowed."
msgstr "需要导出的 GeoSite 分类，可添加多个。"

msgid "Export directory: /var/rust-dns"
msgstr "导出目录：/var/rust-dns"

msgid "GeoIP Tags"
msgstr "GeoIP 分类"

msgid "GeoIP categories to export. Multiple tags are allowed."
msgstr "需要导出的 GeoIP 分类，可添加多个。"

msgid "GeoData Notice"
msgstr "GeoData 提示"

msgid "GeoData export is performed by the rust-dns update tool from v2ray-geosite/v2ray-geoip data. The Update page manages the source archives."
msgstr "GeoData 导出由 rust-dns 更新工具从 v2ray-geosite/v2ray-geoip 数据执行，数据源由“数据库更新”页面管理。"

