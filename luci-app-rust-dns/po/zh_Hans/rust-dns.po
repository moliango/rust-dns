msgid "rust-dns"
msgstr "rust-dns"

msgid "Added domain names always permit resolution using 'Local DNS' with the highest priority (one domain per line, supports domain matching rules)."
msgstr "添加的域名将始终优先使用“本地 DNS”解析（每行一个域名，支持域名匹配规则）。"

msgid "Added domain names will block DNS resolution (one domain per line, supports domain matching rules)."
msgstr "添加的域名将拦截 DNS 解析（每行一个域名，支持域名匹配规则）。"

msgid "Added domain names will always use 'Remote DNS' for resolution (one domain per line, supports domain matching rules)."
msgstr "添加的域名将始终使用“远程 DNS”解析（每行一个域名，支持域名匹配规则）。"

msgid "Added domain names will always use 'Local DNS' for resolution with a forced TTL of 5 seconds and will not be cached (one domain per line, supports domain matching rules)."
msgstr "添加的域名将始终使用“本地 DNS”解析，TTL 强制为 5 秒且不缓存（每行一个域名，支持域名匹配规则）。"

msgid "Custom hosts rewrite, for example: baidu.com 10.0.0.1 (one rule per line, supports domain matching rules)."
msgstr "自定义 Hosts 改写，例如：baidu.com 10.0.0.1（每行一条规则，支持域名匹配规则）。"

msgid "Redirect requests for one domain to another, for example: baidu.com qq.com (one rule per line)."
msgstr "将一个域名的请求重定向到另一个域名，例如：baidu.com qq.com（每行一条规则）。"

msgid "Added domain names will block PTR requests (one domain per line, supports domain matching rules)."
msgstr "添加的域名将拦截 PTR 请求（每行一个域名，支持域名匹配规则）。"

msgid "When 'Custom Stream Media DNS' is enabled, added domains always use the streaming media DNS server for resolution (one domain per line, supports domain matching rules)."
msgstr "启用“自定义流媒体 DNS”后，添加的域名将始终使用流媒体 DNS 服务器解析（每行一个域名，支持域名匹配规则）。"

msgid "Rules saved. The rust-dns service was asked to reload."
msgstr "规则已保存，已请求 rust-dns 服务重新加载。"

msgid "Rules saved, but the service could not be reloaded. Please restart rust-dns manually."
msgstr "规则已保存，但无法重新加载服务。请手动重启 rust-dns。"

msgid "The rule files below are used by the generated configuration. One entry per line."
msgstr "以下规则文件用于生成的配置。每行一条。"

msgid "Saving with \"Save & Apply\" writes every edited file and reloads the rust-dns service."
msgstr "使用“保存并应用”将写入所有已编辑文件并重新加载 rust-dns 服务。"

msgid "Clear this file"
msgstr "清空此文件"

msgid "Clear rule file"
msgstr "清空规则文件"

msgid "Are you sure you want to clear %s? This cannot be undone."
msgstr "确定要清空 %s 吗？此操作无法撤销。"

